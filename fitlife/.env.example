# ===== Núcleo =====
# URL pública da aplicação (usada em links de e-mail e redirecionamentos)
APP_URL="http://localhost:3000"
# PostgreSQL
DATABASE_URL="postgresql://fitlife:fitlife_dev@localhost:5432/fitlife?schema=public"
# Segredo de 32+ caracteres para assinar tokens (gere com: openssl rand -base64 48)
AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio-com-48-caracteres"
# Diretório para uploads privados (fotos de evolução, avatares)
STORAGE_DIR="./storage"

# ===== Fit AI (opcional) =====
# Sem chave, o Fit AI funciona em "modo demonstração local", claramente identificado.
ANTHROPIC_API_KEY=""
FITAI_MODEL="claude-opus-5-5"

# ===== E-mail (opcional) =====
# Sem SMTP, e-mails transacionais são registrados no log do servidor (apenas desenvolvimento).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="FitLife <no-reply@fitlife.app>"

# ===== Pagamentos — Stripe (opcional) =====
# Sem chaves, o checkout fica indisponível (nenhum pagamento é simulado).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ELITE=""

# ===== Administração inicial =====
# E-mail que recebe o papel ADMIN ao rodar o seed
SEED_ADMIN_EMAIL="admin@fitlife.local"
SEED_ADMIN_PASSWORD="Admin@FitLife2026"
